FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set pip cache directory and configuration
ENV PIP_CACHE_DIR=/root/.cache/pip
ENV PIP_NO_CACHE_DIR=false
ENV PIP_TIMEOUT=1000
ENV PIP_RETRIES=10

# Install Python dependencies using the cache
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# Install development tools (also using cache)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install watchdog[watchmedo] python-dotenv

# Configure Flask for development
ENV FLASK_ENV=development
ENV FLASK_DEBUG=1
ENV FLASK_APP=app.py

# Source code will be mounted as a volume
EXPOSE 5000

CMD ["flask", "run", "--host=0.0.0.0", "--port=5000", "--reload"] 