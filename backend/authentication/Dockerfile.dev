FROM openjdk:17-jdk-slim

# Install Maven
RUN apt-get update && \
    apt-get install -y maven

WORKDIR /app

# Copie uniquement du pom.xml d'abord
COPY pom.xml .

# Téléchargement des dépendances uniquement (seront en cache)
RUN mvn dependency:resolve dependency:resolve-plugins dependency:go-offline

# Copie du reste du code
COPY src ./src

# Construction de l'application
RUN mvn clean package -DskipTests

# Port exposé
EXPOSE 8080

# Commande pour démarrer l'application
CMD ["java", "-jar", "target/authentication-0.0.1-SNAPSHOT.jar"]
