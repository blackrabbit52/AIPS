FROM maven:3.8-openjdk-11-slim

WORKDIR /app

# Install Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline

# Configure Spring Boot DevTools
ENV SPRING_DEVTOOLS_REMOTE_SECRET=mysecret
ENV JAVA_OPTS="-Dspring.devtools.restart.enabled=true -Dspring.devtools.livereload.enabled=true"
ENV MAVEN_OPTS="-Xmx512m"

# Source code will be mounted as a volume
EXPOSE 8080

CMD ["./mvnw", "spring-boot:run", "-Dspring-boot.run.jvmArguments='-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005'"] 